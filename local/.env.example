# Copy to local/.env and fill in values. Never commit local/.env.
# Used by ./scripts/up-manager.sh and compose/docker-compose.yml.

# --- required for a new install ---
# Official alternatives (do not regenerate this on an existing database):
#   openssl rand -hex 32
#   ./scripts/generate-key.sh
#   docker run --rm ghcr.io/getarcaneapp/manager:v3.0.1 /app/arcane generate secret
# The key is a passphrase of at least 32 characters, or an exact 32-byte
# value prefixed with hex: or base64:.
ARCANE_ENCRYPTION_KEY=

# Public URL you will open in a browser (no trailing slash).
# Loopback-only lab: http://localhost:3552
# LAN / another device: http://<host-ip>:3552
# Behind a reverse proxy: https://arcane.example.com
ARCANE_APP_URL=http://localhost:3552

# Host folder that holds Compose projects. The bind mount must use the
# same absolute path inside the container. Change all three places
# together (this value, the compose volume, and the directory on disk).
ARCANE_PROJECTS_DIRECTORY=/opt/docker

# --- bind / identity ---
# Lab default: publish only on loopback. Change to 0.0.0.0 only on a
# trusted LAN, and prefer a reverse proxy with TLS for anything else.
ARCANE_BIND=127.0.0.1
ARCANE_PORT=3552
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# Optional: turn off the anonymous check-in to checkin.getarcane.app.
# Official default is on. The old 2.x name ANALYTICS_DISABLED is ignored.
# ARCANE_ANALYTICS_ENABLED=false

# Optional: pin a different registry that serves the same digest
# (verified 2026-11-17: GHCR, Docker Hub and Quay share the index digest).
# ARCANE_IMAGE_REPO=ghcr.io/getarcaneapp/manager
# ARCANE_IMAGE_REPO=getarcaneapp/manager
# ARCANE_IMAGE_REPO=quay.io/getarcaneapp/manager

# Optional first-admin override (read only on an empty database).
# If unset, username is "arcane" and the password is written to
# /app/data/initial-admin-password inside the volume.
# A password you set must meet the policy (12+ chars, upper, lower,
# number, symbol) and is not written to that file.
# ARCANE_DEFAULT_ADMIN_USERNAME=arcane
# ARCANE_DEFAULT_ADMIN_PASSWORD=
# ARCANE_DEFAULT_ADMIN_PASSWORD_FILE=/run/secrets/arcane_admin_password

# --- agent only (compose/docker-compose.agent.yml) ---
# ARCANE_AGENT=true
# ARCANE_AGENT_TRANSPORT=auto
# ARCANE_AGENT_TOKEN=
# ARCANE_MANAGER_API_URL=https://your-manager.example.com
