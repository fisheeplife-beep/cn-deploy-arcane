# Copy to compose/.env only if you start Compose from this directory
# without --env-file. Prefer local/.env at the repo root instead.
# Do not commit compose/.env.

ARCANE_ENCRYPTION_KEY=
ARCANE_APP_URL=http://localhost:3552
ARCANE_PROJECTS_DIRECTORY=/opt/docker
ARCANE_BIND=127.0.0.1
ARCANE_PORT=3552
PUID=1000
PGID=1000
TZ=Asia/Shanghai
# ARCANE_IMAGE_REPO=ghcr.io/getarcaneapp/manager
# ARCANE_ANALYTICS_ENABLED=false
